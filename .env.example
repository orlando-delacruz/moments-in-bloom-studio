# Copy this file to .env and fill in your Supabase project values.
# The anon (public) key is safe to expose — Supabase RLS protects the data.
# Without these set, the contact form runs in demo mode (stored locally in the browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# EmailJS notification for new enquiries (optional — without these, the
# enquiry still saves; only the email is skipped).
# Public Key: emailjs.com → Account → API Keys. Service/Template IDs:
# Email Services / Email Templates pages.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=