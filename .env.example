# Copy this file to .env and fill in your Supabase project values.
# The anon (public) key is safe to expose — Supabase RLS protects the data.
# Without these set, the contact form runs in demo mode (stored locally in the browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# EmailJS — forwards contact form enquiries to the studio Gmail inbox.
# Find these in the EmailJS dashboard (Email Services / Email Templates / Account).
# Without them the form still works (Supabase/demo storage only) — no email is sent.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=